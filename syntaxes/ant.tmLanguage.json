{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ant",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.hash.ant",
      "match": "#.*$"
    },
    "keywords": {
      "name": "keyword.control.ant",
      "match": "^(set|def|ant|use|use_cfg|no_std)"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ant",
          "match": "\\b([A-Z_]+)(\\d*)(?::([0-7]))?\\b",
          "captures": {
            "1": {
              "name": "constant.language.ant"
            },
            "2": {
              "name": "entity.name.type.ant"
            },
            "3": {
              "name": "entity.name.type.ant"
            }
          }
        },
        {
          "name": "constant.language.ant",
          "match": "\\b[01]\\b"
        }
      ]
    },
    "function_calls": {
      "name": "entity.name.function.ant",
      "match": "\\b[a-z][a-z0-9_]*(?=\\s*\\()"
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.ant",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ant",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.ant",
          "match": "\\b(0[b][01]+|0[o][0-7]+|0[x][0-9a-f]+|0\\d+|[1-9]\\d*)\\b"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.braces.ant",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.ant",
          "match": "[()]"
        }
      ]
    }
  },
  "scopeName": "source.ant"
}